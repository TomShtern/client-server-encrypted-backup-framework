{
  "python.terminal.activateEnvironment": true,
  "python.defaultInterpreterPath": "c:/Users/tom7s/Desktopp/Claude_Folder_2/Client_Server_Encrypted_Backup_Framework/flet_venv/Scripts/python.exe",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "FletVenv PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "& '${workspaceFolder}\\flet_venv\\Scripts\\Activate.ps1'"
      ],
      "icon": "terminal-powershell"
    }
  },
  "python.languageServer": "Pylance",
  "python.linting.enabled": true,
  "python.linting.ruffEnabled": true,
  "python.linting.flake8Enabled": false,
  "python.linting.isortEnabled": false,
  "python.formatting.blackEnabled": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.formatOnSave": true
  },
  "terminal.integrated.env.windows": {
    "PYTHONIOENCODING": "utf-8",
    "FLET_V2_DEBUG": "true"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "logs": true,
    // Markdown files visible for documentation editing
    // Note: CLAUDE.md is gitignored but visible in explorer
    "**/*.txt": false,
    "archive": false,
    "**/archive/**": false,
    "_legacy": false,
    "**/_legacy/**": false,
    "**/vcpkg": true,
    "**/build": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/vcpkg": true,
    "**/build": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/vcpkg/**": true,
    "**/build/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "python.analysis.exclude": [
    "**/vcpkg/**",
    "**/build/**",
    "**/node_modules/**",
    "**/dist/**"
  ],
  "problems.exclude": {
    "**/scripts/cmake/vcpkg_buildpath_length_warning.cmake": true,
    "**/archive/**": true,
    "archive/**": true,
    "FletV2/archive/**": true,
    "FletV2/**/archive/**": true,
    "**/_legacy/**": true,
    "_legacy/**": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "editor.experimentalGpuAcceleration": "on",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "sonarlint.pathToCompileCommands": "${workspaceFolder}\\vcpkg\\buildtrees\\pkgconf\\x64-windows-dbg\\compile_commands.json",
  "editor.fontSize": 17,
  "editor.minimap.sectionHeaderFontSize": 10,
  "debug.console.fontSize": 17,
  "scm.inputFontSize": 16,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "chat.editor.fontSize": 18,
  "chat.fontSize": 16,
  "markdown.preview.fontSize": 16,
  "tailwindCSS.rootFontSize": 17,
  "editor.mouseWheelZoom": true,
  "terminal.integrated.mouseWheelZoom": true,
  // AI assistant thinking display: readOnly prevents accidental edits while maintaining visibility
  "chat.agent.thinking.collapsedTools": "readOnly",
  "chat.edits2.enabled": true,
  "chat.extensionUnification.enabled": false,
  "accessibility.openChatEditedFiles": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "c-ares",
    "projectKey": "c-ares_c-ares"
  },
  "[css]": {
    "editor.semanticHighlighting.enabled": false
  },
  "cmake.configureSettings": {
    "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/vcpkg/scripts/buildsystems/vcpkg.cmake",
    "VCPKG_TARGET_TRIPLET": "x64-windows"
  },
  "cmake.generator": "Visual Studio 17 2022",
  "cmake.platform": "x64"
}